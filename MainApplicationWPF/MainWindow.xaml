<ui:FluentWindow x:Class="MainApplicationWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:views="clr-namespace:MainApplicationWPF.Views"
        Title="WPF-UI Navigation Demo" 
        Height="500" Width="800"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Native Fluent Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="My Fluent App" />

        <!-- WinUI 3 Navigation View -->
        <ui:NavigationView Grid.Row="1"
                        x:Name="RootNavigationView"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Visible">

            <!-- Top Navigation Items -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Home" 
                                    Icon="{ui:SymbolIcon Home24}" 
                                    TargetPageType="{x:Type views:HomeView}" />
            </ui:NavigationView.MenuItems>

            <!-- Footer Items (Pinned to Bottom) -->
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="Settings" 
                                    Icon="{ui:SymbolIcon Settings24}" 
                                    TargetPageType="{x:Type views:SettingsView}" />
            </ui:NavigationView.FooterMenuItems>

        </ui:NavigationView>
    </Grid>
</ui:FluentWindow>
