<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" x:Class="MainApplicationWPF.Views.SettingsView"
             >

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ui:DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Grid.Column="0"/>

        <!-- SkiaSharp Canvas Frame -->
        <Border Grid.Column="1" 
                CornerRadius="8" 
                ClipToBounds="True"
                Background="Transparent">

            <skia:SKElement x:Name="SettingsSkiaCanvas" 
                            PaintSurface="SettingsSkiaCanvas_PaintSurface"
                            MouseDown="SettingsSkiaCanvas_MouseDown"
                            MouseWheel="SettingsSkiaCanvas_MouseWheel"
                            MouseMove="SettingsSkiaCanvas_MouseMove"
                            MouseUp="SettingsSkiaCanvas_MouseUp"
                            />
        </Border>
    </Grid>
</UserControl>